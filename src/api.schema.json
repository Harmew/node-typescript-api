{
  "openapi": "3.0.1",
  "info": {
    "version": "1.0.0",
    "title": "Rating"
  },
  "paths": {
    "/rating": {
      "post": {
        "description": "Cria o rating da praia",
        "operationId": "postRating",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Rating"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "O Rating foi criado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ratingObject"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ratingObject": {
        "type": "object",
        "properties": {
          "note": {
            "$ref": "#/components/schemas/note"
          }
        }
      },
      "note": {
        "type": "number",
        "example": 3
      },
      "swellPeriod": {
        "type": "number",
        "example": 8
      },
      "swellHeightRating": {
        "type": "number",
        "example": 3
      },
      "windAndWaveRating": {
        "type": "number",
        "example": 4
      },
      "Rating": {
        "type": "object",
        "properties": {
          "swellPeriod": {
            "$ref": "#/components/schemas/swellPeriod"
          },
          "swellHeightRating": {
            "$ref": "#/components/schemas/swellHeightRating"
          },
          "windAndWaveRating": {
            "$ref": "#/components/schemas/windAndWaveRating"
          }
        },
        "required": ["swellPeriod", "swellHeightRating", "windAndWaveRating"]
      }
    }
  }
}
